<views:DialogBase xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KafkaLens.UI.Views"
        x:Class="KafkaLens.UI.Views.AddEditClusterDialog"
        Title="Add/Edit Cluster"
        Width="480" MinWidth="380" MinHeight="320"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20" RowDefinitions="Auto, Auto">
        <StackPanel Grid.Row="0" Spacing="10">
            <Label Content="Cluster Name"/>
            <TextBox Name="NameBox" PlaceholderText="e.g. Production"/>

            <Label Content="Bootstrap Servers"/>
            <TextBox Name="AddressBox" PlaceholderText="e.g. localhost:9092"/>

            <Label Content="Security"/>
            <ComboBox Name="ProtocolCombo" HorizontalAlignment="Stretch" SelectionChanged="ProtocolCombo_SelectionChanged">
                <ComboBoxItem Content="Plaintext (no encryption)" Tag="Plaintext"/>
                <ComboBoxItem Content="SSL/TLS" Tag="Ssl"/>
                <ComboBoxItem Content="SASL over SSL/TLS (SASL_SSL)" Tag="SaslSsl"/>
                <ComboBoxItem Content="SASL without encryption (SASL_PLAINTEXT)" Tag="SaslPlaintext"/>
            </ComboBox>

            <StackPanel Name="SaslPanel" Spacing="6" IsVisible="False">
                <Label Content="SASL mechanism"/>
                <ComboBox Name="MechanismCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem Content="PLAIN" Tag="Plain"/>
                    <ComboBoxItem Content="SCRAM-SHA-256" Tag="ScramSha256"/>
                    <ComboBoxItem Content="SCRAM-SHA-512" Tag="ScramSha512"/>
                </ComboBox>
                <Label Content="User name (API key)"/>
                <TextBox Name="SaslUsernameBox"/>
                <Label Content="Password (API secret)"/>
                <TextBox Name="SaslPasswordBox" PasswordChar="•"/>
                <Border Name="UnencryptedWarning" IsVisible="False" Padding="8" CornerRadius="4"
                        BorderThickness="1" BorderBrush="{DynamicResource ThemeErrorBrush}">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ThemeErrorBrush}"
                               Text="Warning: SASL_PLAINTEXT sends your user name and password unencrypted. Anyone on the network path can read them. Use SASL over SSL/TLS unless the network is fully trusted."/>
                </Border>
            </StackPanel>

            <StackPanel Name="TlsPanel" Spacing="6" IsVisible="False">
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75"
                           Text="Broker certificates are always verified (trusted CA and matching host name)."/>
                <Label Content="CA certificate (PEM) — optional, defaults to the system trust store"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Name="CaLocationBox" PlaceholderText="e.g. /path/to/ca.pem"/>
                    <Button Grid.Column="1" Content="Browse…" Tag="CaLocationBox" Click="Browse_Click"/>
                </Grid>
                <Label Content="Client certificate (PEM) — only for mutual TLS"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Name="CertificateLocationBox" PlaceholderText="optional"/>
                    <Button Grid.Column="1" Content="Browse…" Tag="CertificateLocationBox" Click="Browse_Click"/>
                </Grid>
                <Label Content="Client private key (PEM)"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Name="KeyLocationBox" PlaceholderText="optional"/>
                    <Button Grid.Column="1" Content="Browse…" Tag="KeyLocationBox" Click="Browse_Click"/>
                </Grid>
                <Label Content="Private key password"/>
                <TextBox Name="KeyPasswordBox" PasswordChar="•" PlaceholderText="only if the key is encrypted"/>
            </StackPanel>

            <TextBlock Name="SecretStorageHint" TextWrapping="Wrap" FontSize="12" Opacity="0.75" IsVisible="False"/>

            <TextBlock Name="ErrorTextBlock" Foreground="{DynamicResource ThemeErrorBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <TextBlock Name="StatusTextBlock" Foreground="{DynamicResource StatusConnectedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            <Expander Name="DetailsExpander" Header="Show error details" IsVisible="False" IsExpanded="False" Margin="0,5,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <TextBox Name="DetailsTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" HorizontalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Expander>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button Name="TestButton" Content="Test Connection" Click="TestButton_Click" IsVisible="False" ToolTip.Tip="Test connection to the Kafka cluster"/>
            <Button Name="OkButton" Content="OK" IsDefault="True" Click="OkButton_Click"/>
            <Button Name="CancelButton" Content="Cancel" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</views:DialogBase>
