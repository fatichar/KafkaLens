<UserControl x:Class="AvaloniaApp.Views.ClusterInfoPanel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KafkaLens.ViewModels;assembly=KafkaLens.ViewModels">
    <StackPanel Orientation="Vertical" VerticalAlignment="Top"
                Margin="10,0,10,0" 
                x:DataType="vm:OpenedClusterViewModel">
        <Label>Cluster Name</Label>
        <TextBox IsReadOnly="True" Text="{Binding Name}" Margin="0,0,0,20"/>
        <Label>Address</Label>
        <TextBox IsReadOnly="True" Text="{Binding Address}" Margin="0,0,0,20"/>
        <Label>Number of Topics</Label>
        <TextBox IsReadOnly="True" Text="{Binding Topics.Count}" Margin="0,0,0,20"/>
    </StackPanel>
</UserControl>